# Local development settings. Copy to .env (never commit .env).
# With nothing set, `npm run dev` uses the password "recall".

# Your own password: run `npm run hash-password` and paste both lines here.
# RECALL_PASSWORD_HASH=
# RECALL_SESSION_SECRET=

# Turns on Ask and auto-tagging. Without it, saving and search still work.
# ANTHROPIC_API_KEY=
# RECALL_MODEL=claude-haiku-5-5

# Used for "today" when answering questions like "how old is Emma?".
# RECALL_TIMEZONE=America/New_York

# Where the database, photos, and search model live.
# RECALL_DATA_DIR=data
# RECALL_MODEL_DIR=models

# A Hugging Face mirror, if huggingface.co is blocked on your network.
# HF_ENDPOINT=
