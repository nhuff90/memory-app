{
  "name": "recall",
  "version": "0.1.0",
  "private": true,
  "description": "A small personal memory app: save anything, find it later by searching or asking.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p server/tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "RECALL_LIVE_AI=1 vitest run server/test/ai.live.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json && tsc -p web/tsconfig.json",
    "eval": "tsx server/eval/run.ts",
    "hash-password": "tsx server/scripts/hash-password.ts",
    "prefetch-model": "tsx server/scripts/prefetch-model.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^4.3.2",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
